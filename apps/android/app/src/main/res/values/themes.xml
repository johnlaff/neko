<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window behind Compose: the warm page color, so launch shows no white flash. -->
    <style name="Theme.Neko" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- The system splash, held while the session is checked: the app icon on the page color. -->
    <style name="Theme.Neko.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Neko</item>
    </style>
</resources>
