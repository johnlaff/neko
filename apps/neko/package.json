{
  "name": "@neko/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate:remote": "wrangler d1 migrations apply neko --remote"
