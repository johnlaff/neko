{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neko",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Only the live version answers: older versions stay unreachable at their own preview URLs,
  // which would otherwise reach the same database and secrets.
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/assetlinks.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neko",
      "database_id": "3f66c7e5-4161-4de1-aea1-7ae5590fc1f1",
      "migrations_dir": "migrations"
    }
  ],
  // Sign-in routes: 10 requests a minute per address (see authLimit in the Worker).
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["0 11 * * *", "0 0 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    // The Android app and the certificates it may be signed with: Play's app signing key (builds
    // installed from Play) and the upload key (builds installed by hand).
    "ANDROID_PACKAGE": "dev.johnlaff.neko",
    "ANDROID_CERT_SHA256": "7A:84:A0:7B:79:0D:D4:7F:97:EB:E9:B0:30:97:45:97:29:43:C0:14:39:00:6A:8D:8E:E6:F2:31:3F:68:03:8B,8C:49:14:31:6D:EE:64:6A:62:90:CD:8D:34:39:14:A1:EC:46:AD:CF:EE:A2:F0:22:1B:E8:8E:91:92:0E:D9:C5",
    // Public Sentry key; empty keeps error reporting off.
    "SENTRY_DSN": "https://4a6a562830187aa449c63d48ecd297a6@o4511712248397824.ingest.us.sentry.io/4512204873793536",
    "VAPID_PUBLIC_KEY": "BJaSC8SH0uXvqyMd8Vetghn_jSOCSmmbpU1TC0jtS1asQxVavHqTsKhAp-ni8-lMajoSLvKhniKwcn0sgMWr0gM"
  }
  // Secrets (wrangler secret put): GOOGLE_SERVICE_ACCOUNT_JSON, SESSION_SECRET, VAPID_PRIVATE_KEY,
  // and the two that would identify the owner in a public repository: SHEET_ID, ALLOWED_EMAILS.
}
